{
  "name": "weon/ecommerce-api",
  "description": "API REST para gerenciar usuários e pedidos.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "vlucas/phpdotenv": "^5.5",
    "firebase/php-jwt": "^6.3",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "robmorgan/phinx": "^0.13.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "phinx migrate -c phinx.php",
    "seed": "phinx seed:run -c phinx.php"
  }
}
